<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="@color/dx_lilac" android:endColor="@color/dx_lilac_dark" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:gravity="top|end" android:width="170dp" android:height="170dp" android:top="-40dp" android:right="-40dp">
        <shape android:shape="oval"><solid android:color="#38FFFFFF" /></shape>
    </item>
</layer-list>
